+def _bluev3_resample(wav: np.ndarray, orig_sr: int, target_sr: int) -> np.ndarray:
+    """NumPy form of torchaudio's training sinc_interp_kaiser resampler."""
+    if orig_sr == target_sr:
+        return np.asarray(wav, dtype=np.float32)
+    gcd = int(np.gcd(orig_sr, target_sr))
+    orig, new = orig_sr // gcd, target_sr // gcd
+    rolloff, width, beta = 0.9475937167399596, 64, 14.769656459379492
+    base = min(orig, new) * rolloff
+    filt_width = int(np.ceil(width * orig / base))
+    idx = np.arange(-filt_width, filt_width + orig, dtype=np.float32)[None, None, :] / np.float32(orig)
+    phase = np.arange(0, -new, -1, dtype=np.float32)[:, None, None] / np.float32(new)
+    t = np.clip((phase + idx) * np.float32(base), -width, width)
+    beta32 = np.float32(beta)
+    window = np.i0(beta32 * np.sqrt(np.maximum(0.0, 1.0 - (t / width) ** 2))) / np.i0(beta32)
+    t *= np.float32(np.pi)
+    kernel = np.sinc(t / np.float32(np.pi)) * window * np.float32(base / orig)
+
+    x = np.asarray(wav, dtype=np.float32)
+    padded = np.pad(x, (filt_width, filt_width + orig))
+    out_len = (new * len(x) + orig - 1) // orig
+    out = np.empty(out_len, dtype=np.float32)
+    # Keep temporary index arrays bounded for long reference recordings.
+    taps = np.arange(kernel.shape[2])
+    for start in range(0, out_len, 2048):
+        stop = min(start + 2048, out_len)
+        positions = np.arange(start, stop)
+        offsets = (positions // new)[:, None] * orig + taps[None, :]
+        out[start:stop] = np.sum(padded[offsets] * kernel[positions % new, 0, :], axis=1, dtype=np.float32)
+    return out
+
+
+def _read_wav_bluev3(path: str, sample_rate: int) -> np.ndarray:
+    wav, sr = sf.read(path, always_2d=True, dtype="float32")
+    wav = wav.mean(axis=1)
+    return _bluev3_resample(wav, int(sr), int(sample_rate))
 
 
